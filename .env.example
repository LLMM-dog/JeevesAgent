# jeeves 配置
# 复制为 .env 后使用。scripts/setup.py 会自动生成一份并填好 ENCRYPTION_KEY。
#
# 命名规则：JEEVES_ 前缀 + 分组名 + 两个下划线 + 字段名
#   JEEVES_APP__HOST  →  settings.app.host
#
# 【为什么必须有 JEEVES_ 前缀】
# 分组名是 APP / AGENT / LLM / SECURITY 这类通用词，不加前缀时系统里任意
# 同名环境变量都会覆盖整个分组。实测本机存在 AGENT=1，不加前缀时启动直接崩在
# "Input should be a valid dictionary or instance of AgentConfig"——
# 报错指向本项目的配置类，但真正原因是一个与本项目无关的环境变量。
#
# 注意：模型凭证不在这里 —— 它们加密存数据库，在 Web 设置页里配。
# 这里只放与具体模型无关的操作参数。

# ─────────────────────────────────────────────
# 服务
# ─────────────────────────────────────────────
JEEVES_APP__HOST=127.0.0.1
JEEVES_APP__PORT=9000
JEEVES_APP__LOG_LEVEL=INFO
# dev: 日志输出到 stdout（彩色可读）  prod: 只写文件（JSON 行便于 grep）
JEEVES_APP__ENV=dev

# ─────────────────────────────────────────────
# 安全
# ─────────────────────────────────────────────
# 用于加密数据库里的 API Key。缺失则拒绝启动 ——
# 没有它所有对话都会因解密失败而挂掉，而报错是"解密错误"，排查方向完全错。
# 生成：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 【备份这个值】丢了以后已存的 API Key 全部无法解密，只能重新填。
JEEVES_SECURITY__ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# LLM 请求参数
# ─────────────────────────────────────────────
# 300 秒。60s 会让代码生成必然失败 —— 实测一次演示请求耗时 220s，
# 22921 个 completion token 里 20994 是推理 token（91%），这段时间流里没有任何数据。
JEEVES_LLM__REQUEST_TIMEOUT=300
# 模型探测是交互式操作（用户在等），必须短。与上面那个是两个不同的值。
JEEVES_LLM__PROBE_TIMEOUT=15
JEEVES_LLM__MAX_RETRIES=3
# false。httpx 默认会读环境变量与 Windows 注册表里的系统代理。
# 实测：本机开着 Clash 时，同一个长生成请求走代理 32s 被掐断，绕过代理 252s 正常完成。
# 代理软件的空闲连接超时远短于一次长推理，而推理阶段不吐任何字节，
# 连接在代理看来就是"空闲"的。
JEEVES_LLM__TRUST_ENV=false

# ─────────────────────────────────────────────
# Agent
# ─────────────────────────────────────────────
# 40。一个真实的代码修改任务轻易用掉 15~25 轮。
# 设小了会在任务快完成时被截断，比多花点 token 糟糕得多。
JEEVES_AGENT__MAX_TURNS=40
# 达到 80% 时注入一次催促（不是硬停），让模型收敛给结论
JEEVES_AGENT__WARN_TURN_RATIO=0.8
# 上下文占用达到窗口的这个比例时压缩。用比例而非固定值 ——
# 模型窗口从 8K 到 200K 不等，固定值在小窗口上永不触发，在大窗口上过早触发。
JEEVES_AGENT__COMPACT_TRIGGER_RATIO=0.75
JEEVES_AGENT__KEEP_TAIL_TURNS=4
JEEVES_AGENT__MAX_SUBAGENT_DEPTH=3
# 审批等待超时。超时视为拒绝 —— 用户离开电脑时不应该有命令自己执行。
JEEVES_AGENT__APPROVAL_TIMEOUT=300

# ─────────────────────────────────────────────
# 沙箱
# ─────────────────────────────────────────────
# local | docker
#
# local 零依赖，但【不是隔离环境】：PathGuard 限制了文件范围、白名单
# 限制了命令，可命令一旦跑起来就是宿主进程 —— 能访问网络、能读环境变量、
# 资源不受限。
#
# docker 需要本机装 Docker 并先拉镜像（docker pull python:3.12-slim）。
# 检测不到时会降级到 local，并在界面上持续显示提示条。
JEEVES_SANDBOX__BACKEND=local
JEEVES_SANDBOX__TIMEOUT_DEFAULT=120
JEEVES_SANDBOX__TIMEOUT_MAX=600
# 输出上限用【行数 + 字节数】双限，先到先算。
# 只用字符数的话，多字节内容下与真实 token 消耗脱节 ——
# 32000 个中文字符约 32000 token，同样字符数的英文只有 8000。
JEEVES_SANDBOX__MAX_OUTPUT_LINES=2000
JEEVES_SANDBOX__MAX_OUTPUT_BYTES=51200
JEEVES_SANDBOX__DOCKER_IMAGE=python:3.12-slim
# none | bridge。默认 none，需要装包时临时改 bridge。
#
# 别改成 host：那样容器直接用宿主的网络命名空间，能 curl 宿主的
# localhost 服务（包括本服务自己的 API）、能访问内网、
# 能打 169.254.169.254 拿云凭证 —— 等于放弃了网络隔离。
JEEVES_SANDBOX__DOCKER_NETWORK=none
JEEVES_SANDBOX__DOCKER_MEMORY=2g
JEEVES_SANDBOX__DOCKER_CPUS=2
# 防 fork 炸弹。DOCKER_MEMORY 挡不住它 ——
# fork 炸弹的每个进程都很小，靠数量而不是内存把系统压垮。
JEEVES_SANDBOX__DOCKER_PIDS_LIMIT=512

# ─────────────────────────────────────────────
# 联网搜索（M7，可选）
# ─────────────────────────────────────────────
# none | duckduckgo | tavily | searxng（searxng 尚未实现）
#
# 默认 none —— 联网搜索会把查询词发给第三方搜索引擎，必须显式开启。
# duckduckgo 免费无需 key；tavily 需要 key 但结果质量更好（为 LLM 优化过）。
# 装依赖：uv sync --extra search --extra web
JEEVES_WEBSEARCH__BACKEND=none
JEEVES_WEBSEARCH__TAVILY_API_KEY=
JEEVES_WEBSEARCH__SEARXNG_URL=

# ─────────────────────────────────────────────
# 定时任务
# ─────────────────────────────────────────────
# 需要 uv sync --extra cron（croniter；Windows 上还会装 tzdata）。
#
# 没有全局开关 —— 任务本身有 enabled 字段，不需要的话不建任务即可。
#
# 注意：定时任务触发的会话【强制 auto 审批】。
# 触发时没有人在旁边点确认，manual 模式下 agent 会挂在等审批上
# 直到超时。所以任务里的 agent 能不经确认执行命令 ——
# 创建界面上有显眼提示。
