# 真实模型验证脚本用的凭证。复制为 .env.verify 后填。
#
# 这个文件【只被 scripts/verify_*.py 和测试脚本读取】，应用本身不用它 ——
# 应用的模型凭证加密存数据库，在 Web 设置页里配。
#
# .env.verify 已在 .gitignore 里，不会被提交。

# ─────────────────────────────────────────────
# 对话模型（必填）
# ─────────────────────────────────────────────
# 所有 verify_*.py 都要用它。OpenAI 兼容接口。
VERIFY_BASE_URL=https://your-provider.example/v1
VERIFY_API_KEY=
VERIFY_MODEL=

# ─────────────────────────────────────────────
# 视觉模型（scripts/verify_vision.py 需要）
# ─────────────────────────────────────────────
# 【为什么要单独一组】
# 视觉核验必须发一次真实的多模态请求才能确认 —— 模型列表接口不返回
# "支不支持图片"这个信息，只能试。而上面那个对话模型很可能不支持图片，
# 用它测的话拿到的是"不支持"，验证不了"支持时能正确工作"这条路径。
#
# 不填的话 verify_vision.py 会跳过多模态部分，只验降级行为
#（未核验的模型不许开视觉模式）。
#
# 留空则回落到 VERIFY_BASE_URL / VERIFY_API_KEY。
# 同一个供应商下换个模型名的话只填 VISION_MODEL 就行。
VERIFY_VISION_BASE_URL=
VERIFY_VISION_API_KEY=
# 例：gpt-4o-mini / qwen-vl-max / gemini-2.0-flash / claude-3-5-sonnet
VERIFY_VISION_MODEL=

# ─────────────────────────────────────────────
# 嵌入模型（scripts/verify_memory.py 需要）
# ─────────────────────────────────────────────
# OpenAI 兼容嵌入 API。用于向量化记忆内容。
# 留空则回落到本地 sentence-transformers。
VERIFY_EMBEDDING_BASE_URL=
VERIFY_EMBEDDING_API_KEY=
VERIFY_EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────
# Rerank 模型（scripts/test_rerank.py 需要）
# ─────────────────────────────────────────────
# 【新增】用于验证 Phase 2 Rerank 重排序功能。
#
# Cohere Rerank（推荐）
# 注册：https://dashboard.cohere.com/api-keys
# 模型：rerank-v3.5（多语言支持，最先进）
VERIFY_RERANK_PROVIDER=cohere
VERIFY_RERANK_BASE_URL=https://api.cohere.com
VERIFY_RERANK_API_KEY=
VERIFY_RERANK_MODEL=rerank-v3.5

# Jina Rerank（开源友好，价格低）
# 注册：https://jina.ai/
# 模型：jina-reranker-v2-base-multilingual
# VERIFY_RERANK_PROVIDER=jina
# VERIFY_RERANK_BASE_URL=https://api.jina.ai
# VERIFY_RERANK_API_KEY=jina_xxxxx
# VERIFY_RERANK_MODEL=jina-reranker-v2-base-multilingual

# Voyage Rerank（专注检索）
# 注册：https://www.voyageai.com/
# 模型：rerank-1
# VERIFY_RERANK_PROVIDER=voyage
# VERIFY_RERANK_BASE_URL=https://api.voyageai.com
# VERIFY_RERANK_API_KEY=pa-xxxxx
# VERIFY_RERANK_MODEL=rerank-1

# ─────────────────────────────────────────────
# 验证建议
# ─────────────────────────────────────────────

# 最小验证配置（无额外 API 成本）：
#   - 不需要任何上述凭证
#   - Phase 1, 3, 4 的测试都是纯算法测试
#
# 运行测试：
#   uv run python scripts/test_recursive_search.py
#   uv run python scripts/test_hybrid_search.py
#   uv run python scripts/test_hotness.py

# 完整验证配置（需要 Rerank API）：
#   - 填写 VERIFY_RERANK_* 字段（Cohere/Jina/Voyage 任选一个）
#   - Phase 2 Rerank 测试需要真实 API 调用
#
# 运行测试：
#   uv run python scripts/test_rerank.py（需要 API key）

# 推荐 API 成本参考：
#   - Cohere Rerank: $1/1000 次调用
#   - Jina Rerank: $0.02/1000 次调用（最便宜，推荐）
#   - Voyage Rerank: $0.05/1000 次调用
