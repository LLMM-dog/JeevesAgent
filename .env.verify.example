# 真实模型验证脚本用的凭证。复制为 .env.verify 后填。
#
# 这个文件【只被 scripts/verify_*.py 读取】，应用本身不用它 ——
# 应用的模型凭证加密存数据库，在 Web 设置页里配。
#
# .env.verify 已在 .gitignore 里，不会被提交。

# ─────────────────────────────────────────────
# 对话模型（必填）
# ─────────────────────────────────────────────
# 所有 verify_*.py 都要用它。OpenAI 兼容接口。
VERIFY_BASE_URL=https://your-provider.example/v1
VERIFY_API_KEY=
VERIFY_MODEL=

# ─────────────────────────────────────────────
# 视觉模型（scripts/verify_vision.py 需要）
# ─────────────────────────────────────────────
# 【为什么要单独一组】
# 视觉核验必须发一次真实的多模态请求才能确认 —— 模型列表接口不返回
# "支不支持图片"这个信息，只能试。而上面那个对话模型很可能不支持图片，
# 用它测的话拿到的是"不支持"，验证不了"支持时能正确工作"这条路径。
#
# 不填的话 verify_vision.py 会跳过多模态部分，只验降级行为
#（未核验的模型不许开视觉模式）。
#
# 留空则回落到 VERIFY_BASE_URL / VERIFY_API_KEY。
# 同一个供应商下换个模型名的话只填 VISION_MODEL 就行。
VERIFY_VISION_BASE_URL=
VERIFY_VISION_API_KEY=
# 例：gpt-4o-mini / qwen-vl-max / gemini-2.0-flash / claude-3-5-sonnet
VERIFY_VISION_MODEL=
