# /etc/systemd/system/jeeves.service
# 由 deploy/deploy.sh 安装。

[Unit]
Description=Jeeves AI assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jeeves
Group=jeeves
WorkingDirectory=/opt/jeeves
EnvironmentFile=/opt/jeeves/.env
ExecStart=/opt/jeeves/.venv/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 9000 --app-dir backend
Restart=on-failure
RestartSec=5

# 安全加固：最小权限
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/jeeves/data /opt/jeeves/workspace /opt/jeeves/skills /opt/jeeves/personas /opt/jeeves/config
ProtectHome=true

[Install]
WantedBy=multi-user.target
