# ─── 密钥与运行时配置 ───
.env
# 真实模型验证用的凭证，只给 scripts/verify_real.py 读
.env.verify
config/*.yaml
!config/*.example.yaml

# ─── 个人数据 ───
# 判据：换一台机器 clone 下来能不能跑起来 + 会不会泄露隐私
data/
workspace/
# 【例外】测试数据必须进仓库 —— 它是 clone 下来能跑测试的前提。
#
# 不加这条会静默丢数据：`data/` 匹配【任意层级】的 data 目录，
# 所以 backend/tests/data/ 也被吞掉。实测踩过：一份对话 fixture
# 写好后 git status 里看不见，重建工作区时消失，而对应的测试
# 报的是 FileNotFoundError，完全不指向 gitignore。
!backend/tests/data/
!backend/tests/data/**
# 人格文件：用户会在设置页里改，跟踪它们会让 git pull 直接失败
# （error: Your local changes would be overwritten by merge）。
# 只跟踪 .example.md，首次启动时复制过来。
personas/SOUL.md
personas/USER.md
personas/AGENTS.md

# ─── Python ───
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── 前端 ───
node_modules/
frontend/dist/
frontend/.vite/
# tsc 的增量编译缓存。机器相关，且每次构建都变
*.tsbuildinfo

# ─── IDE / OS ───
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ─── 数据库备份（迁移前自动生成）───
*.bak.*

# MCP 配置里有 token（Authorization: Bearer xxx），不能进仓库。
# 示例见 config/mcp_servers.example.yaml
config/mcp_servers.yaml

# ── 开发过程，不发布 ──
#
# .dev/ 放调研笔记、踩坑记录、路线图 —— 它们是【开发过程】的产物，
# 对使用者没有价值，而且会把"这个项目是怎么做出来的"混进产品文档里。
#
# 发布给用户的应该是一个完整的产品：介绍、使用说明、API 参考。
# 就像开发布会不会讲内部会议记录。
#
# 这些内容仍然有价值，所以保留在本地而不是删掉 —— 只是不进仓库。
.dev/

# ── 子智能体调研产生的 clone 残留 ──
*_src/
*_repo/
research_repos/
